# caches / OS
__pycache__/
*.pyc
.DS_Store

# local backups (never publish)
*.bak.*

# forge DB migrations are not part of the public MCP marker
migrations/

# secrets
.env
*.key
.venv/

# build stamp — written by stamp_build.py at deploy/boot, never committed.
# Committing it would make the hash depend on the previous hash and would make
# every tree permanently dirty by one file.
build_info.json

# CI step artefacts (release-gate.yml writes these into the workspace)
junit.xml
pytest.out
