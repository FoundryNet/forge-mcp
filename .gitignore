# caches / OS
__pycache__/
*.pyc
.DS_Store

# local backups (never publish)
*.bak.*

# forge DB migrations are not part of the public MCP marker
migrations/

# secrets
.env
*.key
.venv/

# build stamp — written by stamp_build.py at deploy/boot, never committed.
# Committing it would make the hash depend on the previous hash and would make
# every tree permanently dirty by one file.
build_info.json

# agent-harness report - written by tests/mcp_agent_test.py on every run, never
# committed. It records the machine's own scratchpad paths, the forge_core
# revision it ran against and a fresh timestamp, so a committed copy is stale
# the moment anyone re-runs the harness. docs/mcp_demo_sequence.md already says
# to re-run the harness and re-read the report before quoting it.
tests/mcp_agent_results.json

# CI step artefacts (release-gate.yml writes these into the workspace)
junit.xml
pytest.out
